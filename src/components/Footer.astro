---
import { profile } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-inner">
    <span class="muted">© {year} {profile.name}</span>
    <div class="f-links">
      <a href={profile.socials.github} target="_blank" rel="noopener">GitHub</a>
      <a href={profile.socials.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={profile.socials.instagram} target="_blank" rel="noopener">Instagram</a>
      <a href={`mailto:${profile.email}`}>Email</a>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--border); padding: 28px 0; }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    font-size: 0.9rem;
  }
  .f-links { display: flex; gap: 18px; }
  .f-links a { color: var(--muted); }
  .f-links a:hover { color: var(--text); text-decoration: none; }
</style>
