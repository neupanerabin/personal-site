---
import { profile } from '../data/site';
const initials = profile.name.split(' ').map((n) => n[0]).join('');
---

<header class="nav">
  <div class="wrap nav-inner">
    <a href="/" class="brand">{initials}<span class="dot">.</span></a>
    <nav class="links">
      <a href="/#about">About</a>
      <a href="/#experience">Experience</a>
      <a href="/#projects">Projects</a>
      <a href="/blog">Blog</a>
      <a href="/#contact">Contact</a>
    </nav>
    <button id="theme-toggle" class="theme-btn" aria-label="Toggle theme">
      <span class="t-dark">☾</span><span class="t-light">☀</span>
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(10px);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    gap: 16px;
  }
  .brand { font-weight: 700; font-size: 1.1rem; color: var(--text); }
  .brand:hover { text-decoration: none; }
  .dot { color: var(--accent); }
  .links { display: flex; gap: 22px; }
  .links a { color: var(--muted); font-size: 0.92rem; }
  .links a:hover { color: var(--text); text-decoration: none; }
  .theme-btn {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: 8px;
    width: 36px;
    height: 36px;
    cursor: pointer;
    font-size: 1rem;
  }
  .t-light { display: none; }
  :global(:root[data-theme='light']) .t-dark { display: none; }
  :global(:root[data-theme='light']) .t-light { display: inline; }
  @media (max-width: 560px) {
    .links { gap: 14px; font-size: 0.85rem; }
    .links a:nth-child(1) { display: none; }
  }
</style>

<script is:inline>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch (e) {}
  });
</script>
