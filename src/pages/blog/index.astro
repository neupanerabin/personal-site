---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Layout title="Blog — Rabin Neupane" description="Writing on backend engineering, DevOps, and systems.">
  <section>
    <div class="wrap">
      <p class="section-title">Blog</p>
      <h1 style="font-size:1.8rem;margin-bottom:8px">Notes & write-ups</h1>
      <p class="muted" style="margin-bottom:28px">
        Things I learn while building backends and wrangling systems.
      </p>

      {posts.length === 0 && <p class="muted">No posts yet — check back soon.</p>}

      <div class="post-list">
        {posts.map((post) => (
          <a class="post-card" href={`/blog/${post.id}`}>
            <div>
              <h3>{post.data.title}</h3>
              <p class="muted">{post.data.description}</p>
              <div class="tags">
                {post.data.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            </div>
            <time class="muted">{fmt(post.data.pubDate)}</time>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .post-list { display: flex; flex-direction: column; gap: 14px; }
  .post-card {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 18px;
    padding: 20px 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
    color: var(--text);
    transition: border-color 0.15s ease;
  }
  .post-card:hover { text-decoration: none; border-color: var(--accent); }
  .post-card h3 { font-size: 1.15rem; margin-bottom: 6px; }
  .post-card time { font-size: 0.82rem; white-space: nowrap; }
  @media (max-width: 560px) {
    .post-card { flex-direction: column; }
    .post-card time { white-space: normal; }
  }
</style>
